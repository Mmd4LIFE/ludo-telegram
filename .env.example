# ============================================================================
#  Ludo Board — Telegram Ludo Game — Environment Configuration
#  Copy this file to `.env` and adjust before `docker compose up -d`.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# BotFather HTTP API token for the Ludo bot.
BOT_TOKEN=
# Public HTTPS base URL where the Mini App is served (no trailing slash).
PUBLIC_URL=https://your-ludo-domain.example
# Mini App URL (usually the same as PUBLIC_URL). Used for the WebApp button.
WEBAPP_URL=https://your-ludo-domain.example
# Bot run mode: "polling" (no HTTPS needed) or "webhook" (needs HTTPS PUBLIC_URL).
BOT_MODE=polling
# Secret path token for the webhook endpoint (only used in webhook mode).
WEBHOOK_SECRET=change-me-to-a-random-string

# --- Security ---------------------------------------------------------------
# Secret used to sign session JWTs issued to the Mini App.
SECRET_KEY=change-me-super-secret-key-please
# Comma separated Telegram user IDs that get admin powers.
ADMIN_IDS=

# --- Admin AI / Insights ----------------------------------------------------
# Server-side only; never sent to the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Model for the Insights analyst (empty = OPENAI_MODEL). A stronger model writes better SQL.
OPENAI_INSIGHTS_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
# Admin timezone for "today" / "this week" (minutes from UTC, e.g. 210 = UTC+03:30).
INSIGHTS_TZ_OFFSET_MINUTES=0
# Read-only Postgres role used by Insights + the SQL tab (created at boot).
# Password is derived from SECRET_KEY when empty.
INSIGHTS_RO_ROLE=ludo_ro
INSIGHTS_RO_PASSWORD=
INSIGHTS_SQL_TIMEOUT_MS=15000
INSIGHTS_MAX_ROWS=1000

# --- Database ---------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
# AsyncPG pool (keep small on a shared 1GB box)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=10
# Live-match caps
MAX_VIEWERS_PER_MATCH=16
ACTION_QUEUE_MAX=64
PERSIST_EVERY_N_STEPS=5
MAX_ACTIVE_ROOMS_PER_USER=3
ROOM_IDLE_CLOSE_HOURS=1.0
PRESENCE_TOUCH_SECONDS=60
WS_SEND_TIMEOUT_SECONDS=2.0

# --- Web port (host side) ---------------------------------------------------
# nginx binds 127.0.0.1:${WEB_PORT}. Pick a port not used by other bots on the box.
WEB_PORT=8081

# --- Economy ----------------------------------------------------------------
# New users start at 0. Set these only if you want faucet bonuses.
SIGNUP_BONUS_COINS=0
DAILY_REWARD_COINS=0
BOT_START_BONUS=0

# --- Gameplay ---------------------------------------------------------------
# Seconds a player has to act before the server auto-plays for them.
TURN_TIMEOUT_SECONDS=25
BOT_THINK_MIN=1.2
BOT_THINK_MAX=3.0
# Number of self-play bot tables kept running to keep the lobby alive.
BOT_TABLES=1

# --- App --------------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
